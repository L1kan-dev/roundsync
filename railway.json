{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "services": {
    "frontend": {
      "source": {
        "root": "frontend"
      }
    },
    "api": {
      "source": {
        "root": "services/api"
      }
    },
    "watcher": {
      "source": {
        "root": "services/watcher"
      }
    },
    "gc-worker": {
      "source": {
        "root": "services/gc-worker"
      }
    }
  }
}
